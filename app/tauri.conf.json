{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATS WestPlay",
  "version": "2.1.2",
  "identifier": "app.westplay.ats",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:release",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ATS WestPlay",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "ATS WestPlay contributors",
    "copyright": "Copyright © 2026 WestPlay. Licensed under the GPL-3.0-or-later.",
    "category": "Game",
    "shortDescription": "WestPlay 美国卡车模拟 ATS 适配版",
    "longDescription": "WestPlay 的 ATS 适配版，保留车载地图、音乐、视频及界面设置，并提供中文启动、连接检查、诊断修复和日志入口。车辆屏幕与地图兼容性以实际测试记录为准。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/",
      "../target/release/westplay.dll": "westplay.dll",
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "../tools/ats-installer-hooks.nsh",
        "startMenuFolder": "ATS WestPlay"
      }
    }
  },
  "plugins": {}
}
